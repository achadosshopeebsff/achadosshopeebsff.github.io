{
  "mode": "initial-fixed-then-dynamic-api",
  "refreshIntervalMinutes": 30,
  "maxProducts": 500,
  "_maxProductsNote": "sem limite 'de verdade' no sentido pratico: o pool de candidatos por ciclo (150+ keywords x 50 + retries) costuma passar de 5000 produtos unicos, entao 500 e alcancavel com folga mantendo qualidade (rating minimo + cooldown anti-repeticao). O front-end (index.html) nao tem mais teto de exibicao - mostra o catalogo inteiro.",
  "minDynamicProducts": 250,
  "pagesPerKeyword": 1,
  "limitPerQuery": 50,
  "topPerformingLimit": 50,
  "includeTopPerforming": true,
  "preserveCatalogOnApiFailure": true,
  "rotateSortType": true,
  "pageRotationSpan": 3,
  "_pageRotationSpanNote": "gira a pagina inicial de cada keyword (1,2,3,1,2,3...) por execucao, combinado ao sortType, para trazer produtos diferentes a cada ciclo",
  "repeatCooldownRuns": 4,
  "_repeatCooldownRunsNote": "um produto so pode ser republicado depois de 4 execucoes (~2h com o intervalo de 30min) - usa o historico persistente em product-history.json, nao so o ciclo anterior",
  "minRating": 4.0,
  "subIds": [
    "achadosshopeebsf",
    "auto",
    "site"
  ],
  "_trendingCategoriesSource": "Categorias de maior GMV/consumo na Shopee Brasil, projecao 2026 a 2027 (ver README > Categorias e keywords).",
  "trendingCategoryBoost": {
    "Casa": 6,
    "Beleza": 5,
    "Pets": 5,
    "Auto & Moto": 4,
    "Eletrônicos": 3,
    "Cozinha": 3
  },
  "_categoryQuotasNote": "vaga MINIMA garantida por categoria a cada ciclo, para itens de ticket maior (celular, notebook, geladeira) nao serem afogados por acessorio barato na pontuacao geral. Ajuste os numeros a vontade; nao impede a categoria de ter MAIS que a cota se pontuar bem.",
  "categoryQuotas": {
